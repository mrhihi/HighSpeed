# TDX 帳號金鑰設定
# 請至 https://tdx.transportdata.tw 註冊會員，於【會員中心->資料服務->API金鑰】取得 Client Id / Client Secret
TDX_CLIENT_ID=your-client-id
TDX_CLIENT_SECRET=your-client-secret

# TDX API 呼叫限制（後端會在實際呼叫間自動暫停）
TDX_MAX_REQUESTS_PER_SECOND=1
TDX_MAX_REQUESTS_PER_MINUTE=5
# 保守的請求間隔；預設 5 秒（會取此值與上方限制計算出的較大值）
TDX_MIN_REQUEST_INTERVAL_MS=5000
TDX_MAX_429_RETRIES=2

# TDX 資料快取時效（毫秒）；座位預設 60 秒，其餘資料預設 24 小時
TDX_SEAT_CACHE_TTL_MS=60000
TDX_TIMETABLE_CACHE_TTL_MS=86400000
TDX_FREE_SEATING_CACHE_TTL_MS=86400000

# 後端伺服器監聽埠號
PORT=4000
