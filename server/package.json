{
  "name": "highspeed-server",
  "version": "1.0.0",
  "private": true,
  "description": "TDX THSR available-seat query proxy server",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run clean && esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/index.js --sourcemap",
    "build:modules": "npm run clean && tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "npm run build:modules && node --test tests/*.test.cjs; status=$?; npm run build; exit $status",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
